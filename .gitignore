# Capacitor 生成物：public/ 由 CI 从 dist 复制，不入库。
# 但 android/app/src/main/assets/capacitor.config.json 与 capacitor.plugins.json
# 必须入库 —— CI 刻意不跑 npx cap sync（会覆盖 capacitor.settings.gradle 导致白屏），
# 这两个文件是运行时配置与插件注册表的唯一来源，缺了 App 起不来、蓝牙和串口
# 全部报 "not implemented"。
android/app/src/main/assets/public/

# Android 构建与本地配置
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/.idea/
android/.kotlin/
android/capacitor-cordova-android-plugins/build/
*.iml
*.hprof

# 签名文件（严禁入库）
*.keystore
*.jks
key.properties
google-services.json

